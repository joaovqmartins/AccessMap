# Imagem de desenvolvimento: roda o app no navegador (expo start --web).
# O codigo chega pelo Compose Watch (veja docker-compose.yml), nao por bind mount.
FROM node:24-bookworm-slim
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# Sem isso o Expo tenta abrir o navegador de dentro do container e cai.
ENV BROWSER=none
EXPOSE 8081
CMD ["npx", "expo", "start", "--web", "--port", "8081"]
