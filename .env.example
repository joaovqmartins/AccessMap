# Copie para .env (ignorado pelo git) ou exporte no ambiente antes de subir o backend.

# Opcional. Defaults apontam para o Postgres do docker-compose.
DB_URL=jdbc:postgresql://localhost:5432/accessmap
DB_USERNAME=postgres
DB_PASSWORD=accessmap123

# Obrigatorio. Chave HMAC que assina os access tokens. Minimo 32 caracteres.
# Gere com:  openssl rand -base64 48
JWT_SECRET=

# Opcional. Se ambos estiverem definidos e ainda nao existir nenhum ADMIN, o primeiro admin e criado no boot.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Opcional. Origens do front separadas por virgula.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
