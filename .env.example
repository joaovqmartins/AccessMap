# =============================================================================
#  AccessMap - variaveis do BACKEND (Spring Boot)
# =============================================================================
#  Como usar:
#    1. Copie este arquivo para ".env", na raiz do projeto (o git ignora o .env).
#    2. Preencha o que estiver marcado como OBRIGATORIO.
#    3. Rode o BackendApplication pelo IntelliJ. O Spring le o .env sozinho
#       e sobe o Postgres do docker-compose.yml (precisa do Docker aberto).
#
#  Variaveis de ambiente de verdade (CI, deploy) tem prioridade sobre este arquivo.
#  Valores ficam sem aspas: tudo depois do "=" e o valor.
# =============================================================================


# --- 1. Seguranca -------------------------------------------------------------

# OBRIGATORIO. Chave que assina os tokens de login (JWT). Minimo 32 caracteres.
# Gere uma com:  openssl rand -base64 48   (no Git Bash)
JWT_SECRET=


# --- 2. Primeiro administrador ------------------------------------------------

# Opcional. Com os dois preenchidos, e se ainda nao existir nenhum ADMIN,
# o backend cria esse usuario ADMIN ao subir. Telefone so com numeros, com DDD.
ADMIN_PHONE=
ADMIN_PASSWORD=


# --- 3. App no navegador (CORS) -----------------------------------------------

# Origens que podem chamar a API pelo navegador, separadas por virgula.
# http://localhost:8081 e o "npm run web" do frontend. Vazio desliga o CORS
# (app no celular/emulador nao precisa). Nao defina em producao.
CORS_ALLOWED_ORIGINS=http://localhost:8081


# --- 4. Banco de dados (normalmente nao mexa) ---------------------------------

# Rodando pela IDE, a conexao com o Postgres do Docker e configurada sozinha.
# Descomente so para apontar para outro banco (ex.: deploy).
# DB_URL=jdbc:postgresql://localhost:5432/accessmap
# DB_USERNAME=postgres
# DB_PASSWORD=accessmap123
